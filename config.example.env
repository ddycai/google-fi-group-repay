# Generated by `npm run build:env` from config.json — this is the shape it
# produces. Do not edit this file or config.env by hand: config.json is the
# source of truth, and a hand-edit is a second copy free to drift from it.
#
# Import into Val Town: val settings -> Environment variables -> import config.env

FI_GROUP_REPAY_CONFIG='{"people":[{"name":"Your Name","isOwner":true},{"name":"Friend One","venmo":"friend-one-handle"},{"name":"Friend Two","venmo":"friend-two-handle"}],"noteTemplate":"Google Fi — {month}"}'

# Who the val accepts statements from, taken from "allowedSenders" in
# config.json. Gmail's automatic forwarding preserves Fi's own address;
# pressing Forward by hand sends it as you, so your address has to be listed
# for that to work. Both are shipped in config.example.json — see the README.
FI_GROUP_REPAY_ALLOWED_SENDERS='payments-noreply@google.com,your-email@example.com'
